# Copy file này thành .env rồi điền giá trị thật. Không đưa file .env lên GitHub.
PORT=3000

# Đổi user, mật khẩu, cổng nếu PostgreSQL của bạn khác mặc định
DATABASE_URL=postgres://postgres:MAT_KHAU_CUA_BAN@localhost:5432/gyusachi

# Nếu báo lỗi "Invalid URL" (thường do mật khẩu có ký tự đặc biệt như @ # / %):
# xóa dòng DATABASE_URL ở trên và bỏ dấu # ở 5 dòng dưới, điền mật khẩu nguyên văn, không cần mã hóa.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=MAT_KHAU_CUA_BAN
# DB_NAME=gyusachi

# Chuỗi bí mật để ký JWT, đặt dài và ngẫu nhiên
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien

# Địa chỉ công khai của website, để bot gửi link sơ đồ bàn cho khách. Demo qua ngrok thì điền địa chỉ ngrok, ví dụ https://xxxx.ngrok-free.app
PUBLIC_URL=

# Dùng cho phân hệ Facebook (điền sau)
FB_VERIFY_TOKEN=gyusachi-verify-token
FB_APP_SECRET=
# Page Access Token của fanpage (để hệ thống gửi tin trả lời lên Facebook thật). Để trống = chỉ ghi lại, không gửi.
FB_PAGE_ACCESS_TOKEN=
